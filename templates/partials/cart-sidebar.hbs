<!-- Cart Sidebar -->
<div class="cart-sidebar" data-cart-sidebar aria-hidden="true">
    <div class="cart-sidebar-overlay" data-action="close-cart"></div>
    <div class="cart-sidebar-content" role="dialog" aria-label="Shopping Cart">
        <div class="cart-sidebar-header">
            <h2>Shopping Cart</h2>
            <button class="close-btn" data-action="close-cart" aria-label="Close cart">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"/>
                    <line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
            </button>
        </div>

        <div class="cart-items" data-cart-items>
            <!-- Cart items rendered by JavaScript -->
            <div class="cart-empty" data-cart-empty>
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="9" cy="21" r="1"/>
                    <circle cx="20" cy="21" r="1"/>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                </svg>
                <p>Your cart is empty</p>
                <a href="products.html" class="btn btn-primary">Start Shopping</a>
            </div>
        </div>

        <div class="cart-sidebar-footer" data-cart-footer style="display: none;">
            <div class="cart-totals">
                <div class="cart-subtotal">
                    <span>Subtotal</span>
                    <span data-cart-subtotal>{{currencySymbol}}0.00</span>
                </div>
                <p class="cart-shipping-note">Shipping & taxes calculated at checkout</p>
            </div>
            <div class="cart-actions">
                <a href="cart.html" class="btn btn-secondary">View Cart</a>
                <a href="checkout.html" class="btn btn-primary">Checkout</a>
            </div>
        </div>
    </div>
</div>
