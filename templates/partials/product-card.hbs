<article class="product-card" data-product-id="{{id}}" data-product='{{json this}}'>
    <a href="product/{{slug name}}-{{id}}.html" class="product-card-link">
        <div class="product-image-wrapper">
            {{#if images.[0]}}
            <picture>
                <source srcset="{{imageUrl images.[0] 'medium'}}" type="image/webp">
                <img
                    src="{{imageUrl images.[0] 'medium'}}"
                    alt="{{name}}"
                    loading="lazy"
                    decoding="async"
                    width="300"
                    height="300"
                    class="product-image"
                >
            </picture>
            {{else}}
            <div class="product-image-placeholder">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                    <rect x="3" y="3" width="18" height="18" rx="2"/>
                    <circle cx="8.5" cy="8.5" r="1.5"/>
                    <polyline points="21 15 16 10 5 21"/>
                </svg>
            </div>
            {{/if}}

            {{#if on_sale}}
            <span class="product-badge sale">Sale</span>
            {{/if}}

            {{#if featured}}
            <span class="product-badge featured">Featured</span>
            {{/if}}

            {{#unless (inStock stock_status)}}
            <span class="product-badge out-of-stock">Out of Stock</span>
            {{/unless}}
        </div>

        <div class="product-info">
            {{#if categories.[0]}}
            <span class="product-category">{{categories.[0].name}}</span>
            {{/if}}

            <h3 class="product-title">{{name}}</h3>

            {{#if average_rating}}
            <div class="product-rating">
                {{{starRating average_rating}}}
                <span class="rating-count">({{rating_count}})</span>
            </div>
            {{/if}}

            <div class="product-price">
                {{#if on_sale}}
                <span class="price-regular strikethrough">{{formatPrice regular_price}}</span>
                <span class="price-sale">{{formatPrice sale_price}}</span>
                {{else}}
                <span class="price-regular">{{formatPrice price}}</span>
                {{/if}}
            </div>
        </div>
    </a>

    <div class="product-actions">
        {{#if (inStock stock_status)}}
        <button
            class="btn btn-primary add-to-cart"
            data-action="add-to-cart"
            data-product-id="{{id}}"
            data-product-name="{{name}}"
            data-product-price="{{price}}"
            data-product-image="{{#if images.[0]}}{{images.[0].src}}{{/if}}"
            aria-label="Add {{name}} to cart"
        >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="9" cy="21" r="1"/>
                <circle cx="20" cy="21" r="1"/>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
            </svg>
            Add to Cart
        </button>
        {{else}}
        <button class="btn btn-secondary" disabled>Out of Stock</button>
        {{/if}}

        {{#if ../enableWishlist}}
        <button
            class="btn btn-icon wishlist-btn"
            data-action="toggle-wishlist"
            data-product-id="{{id}}"
            aria-label="Add {{name}} to wishlist"
        >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
        </button>
        {{/if}}
    </div>
</article>
