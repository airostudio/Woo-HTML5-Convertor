{{#> layouts-base}}
{{#*inline "body"}}

<div class="container">
    {{> partials-breadcrumb}}

    <div class="shop-page">
        <!-- Category Header -->
        <header class="category-header">
            <h1 class="category-title">{{category.name}}</h1>
            {{#if category.description}}
            <p class="category-description">{{category.description}}</p>
            {{/if}}
            <p class="product-count">{{totalProducts}} products</p>
        </header>

        <!-- Shop Layout -->
        <div class="shop-layout">
            {{> partials-sidebar}}

            <div class="shop-content">
                <!-- Toolbar -->
                <div class="shop-toolbar">
                    <div class="toolbar-left">
                        <button class="filter-toggle-btn" data-action="toggle-sidebar" aria-label="Toggle filters">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="4" y1="21" x2="4" y2="14"/>
                                <line x1="4" y1="10" x2="4" y2="3"/>
                                <line x1="12" y1="21" x2="12" y2="12"/>
                                <line x1="12" y1="8" x2="12" y2="3"/>
                                <line x1="20" y1="21" x2="20" y2="16"/>
                                <line x1="20" y1="12" x2="20" y2="3"/>
                                <line x1="1" y1="14" x2="7" y2="14"/>
                                <line x1="9" y1="8" x2="15" y2="8"/>
                                <line x1="17" y1="16" x2="23" y2="16"/>
                            </svg>
                            Filters
                        </button>
                        <span class="results-count">
                            Showing <strong data-showing-count>{{products.length}}</strong> of <strong>{{totalProducts}}</strong> results
                        </span>
                    </div>

                    <div class="toolbar-right">
                        <div class="view-toggle">
                            <button class="view-btn active" data-view="grid" aria-label="Grid view">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="3" width="7" height="7"/>
                                    <rect x="14" y="3" width="7" height="7"/>
                                    <rect x="14" y="14" width="7" height="7"/>
                                    <rect x="3" y="14" width="7" height="7"/>
                                </svg>
                            </button>
                            <button class="view-btn" data-view="list" aria-label="List view">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <line x1="8" y1="6" x2="21" y2="6"/>
                                    <line x1="8" y1="12" x2="21" y2="12"/>
                                    <line x1="8" y1="18" x2="21" y2="18"/>
                                    <line x1="3" y1="6" x2="3.01" y2="6"/>
                                    <line x1="3" y1="12" x2="3.01" y2="12"/>
                                    <line x1="3" y1="18" x2="3.01" y2="18"/>
                                </svg>
                            </button>
                        </div>

                        <select class="sort-select desktop-sort" data-sort-select aria-label="Sort products">
                            <option value="default">Default sorting</option>
                            <option value="price-low">Price: Low to High</option>
                            <option value="price-high">Price: High to Low</option>
                            <option value="name-az">Name: A to Z</option>
                            <option value="name-za">Name: Z to A</option>
                            <option value="newest">Newest First</option>
                            <option value="rating">Highest Rated</option>
                        </select>
                    </div>
                </div>

                <!-- Subcategories -->
                {{#if subcategories.length}}
                <div class="subcategories">
                    {{#each subcategories}}
                    <a href="category/{{slug this.name}}-{{this.id}}.html" class="subcategory-link">
                        {{this.name}}
                        <span class="count">({{this.count}})</span>
                    </a>
                    {{/each}}
                </div>
                {{/if}}

                <!-- Products Grid -->
                <div class="product-grid" data-products-grid data-products='{{json products}}'>
                    {{#each products}}
                    {{> partials-product-card this}}
                    {{else}}
                    <div class="no-products">
                        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <circle cx="11" cy="11" r="8"/>
                            <path d="m21 21-4.3-4.3"/>
                        </svg>
                        <h3>No products found</h3>
                        <p>Try adjusting your filters or search terms</p>
                        <a href="products.html" class="btn btn-primary">View All Products</a>
                    </div>
                    {{/each}}
                </div>

                <!-- Pagination -->
                {{> partials-pagination}}
            </div>
        </div>
    </div>
</div>

{{/inline}}
{{/layouts-base}}
