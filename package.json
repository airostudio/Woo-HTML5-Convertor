{
  "name": "woo-html5-convertor",
  "version": "1.0.0",
  "description": "Convert WooCommerce stores to blazing-fast HTML5 static sites",
  "main": "src/index.js",
  "bin": {
    "woo-convert": "./bin/cli.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "convert": "node bin/cli.js",
    "wizard": "node wizard/server.js",
    "api": "node web/api-server.js",
    "serve": "npx serve output",
    "build": "node src/builder.js",
    "test": "node tests/test.js"
  },
  "keywords": [
    "woocommerce",
    "html5",
    "static-site",
    "ecommerce",
    "converter",
    "performance"
  ],
  "author": "Woo-HTML5-Convertor",
  "license": "MIT",
  "dependencies": {
    "@woocommerce/woocommerce-rest-api": "^1.0.1",
    "archiver": "^6.0.1",
    "axios": "^1.6.2",
    "chalk": "^4.1.2",
    "cheerio": "^1.0.0-rc.12",
    "clean-css": "^5.3.3",
    "commander": "^11.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fs-extra": "^11.2.0",
    "glob": "^10.3.10",
    "handlebars": "^4.7.8",
    "html-minifier-terser": "^7.2.0",
    "imagemin": "^8.0.1",
    "imagemin-mozjpeg": "^10.0.0",
    "imagemin-pngquant": "^9.0.2",
    "imagemin-svgo": "^10.0.1",
    "imagemin-webp": "^8.0.0",
    "inquirer": "^8.2.6",
    "marked": "^11.1.0",
    "ora": "^5.4.1",
    "pako": "^2.1.0",
    "sanitize-html": "^2.11.0",
    "sharp": "^0.33.0",
    "terser": "^5.26.0",
    "uuid": "^9.0.0",
    "workbox-build": "^7.0.0"
  },
  "devDependencies": {
    "eslint": "^8.56.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
